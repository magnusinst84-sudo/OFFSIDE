# OFFSIDE Backend Environment Configuration

# API-Football key (v3.football.api-sports.io)
# Obtain from https://dashboard.api-football.com
API_FOOTBALL_KEY=your_api_football_key_here

# Google Gemini API key
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Enable deterministic mock fixtures and stats fallback when true (bypasses API-Football)
MOCK_MODE=true

# Controls live API-Football player lookups (GET /api/players/{id} and /{id}/dna).
# When false (default), returns cached/seeded profiles or a 404 to conserve API-Football quota.
ENABLE_LIVE_PLAYER_LOOKUP=false

# Daily API-Football outbound call cap (UTC day, tracked in SQLite).
# Default 80 calls/day. Trips 15-minute circuit breaker when reached.
API_FOOTBALL_DAILY_CAP=80

# Configurable Cache TTLs (in seconds)
TTL_MATCHES_LIVE=45
TTL_MATCHES_UPCOMING=600
TTL_MATCHES_FINISHED=600
TTL_MATCH_DETAIL_LIVE=45
TTL_MATCH_DETAIL_FINISHED=3600
TTL_MATCH_STATS=30
TTL_MATCH_EVENTS=30
TTL_MATCH_LINEUPS=900
TTL_PLAYER_SEARCH=86400
TTL_PLAYER_DETAIL=86400
TTL_PLAYER_DNA=86400

# Optional CORS configuration
# FRONTEND_URL=http://localhost:3000
# ENVIRONMENT=development
