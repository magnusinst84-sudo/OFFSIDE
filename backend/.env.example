# OFFSIDE Backend Environment Configuration

# API-Football key (v3.football.api-sports.io)
# Obtain from https://dashboard.api-football.com
API_FOOTBALL_KEY=your_api_football_key_here

# Google Gemini API key
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Enable deterministic mock fixtures and stats fallback when true (bypasses API-Football)
MOCK_MODE=false

# Controls live API-Football player lookups (GET /api/players/{id} and /{id}/dna).
# When false (default), returns cached/seeded profiles or a 404 to conserve API-Football quota.
ENABLE_LIVE_PLAYER_LOOKUP=false

# Optional CORS configuration
# FRONTEND_URL=http://localhost:3000
# ENVIRONMENT=development
